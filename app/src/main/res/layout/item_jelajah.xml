<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/permukaan"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/garis_batas"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoto"
                android:layout_width="86dp"
                android:layout_height="86dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/fotoImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto destinasi"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textNama"
                style="@style/Teks.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nama Destinasi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardFoto"
                app:layout_constraintTop_toTopOf="@+id/cardFoto" />

            <TextView
                android:id="@+id/textLokasi"
                style="@style/Teks.Metadata"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:text="Kabupaten · Kategori"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardFoto"
                app:layout_constraintTop_toBottomOf="@+id/textNama" />

            <ImageView
                android:id="@+id/icBintang"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/ic_star"
                app:layout_constraintStart_toEndOf="@+id/cardFoto"
                app:layout_constraintTop_toBottomOf="@+id/textLokasi" />

            <TextView
                android:id="@+id/textRating"
                style="@style/Teks.Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0,0 · 0 ulasan"
                app:layout_constraintBottom_toBottomOf="@+id/icBintang"
                app:layout_constraintStart_toEndOf="@+id/icBintang"
                app:layout_constraintTop_toTopOf="@+id/icBintang" />

            <TextView
                android:id="@+id/textStatus"
                style="@style/Teks.Metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_normal"
                android:drawablePadding="4dp"
                android:fontFamily="@font/jakarta_sans_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Normal"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardFoto" />

            <TextView
                android:id="@+id/textTiket"
                style="@style/Teks.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textColor="@color/hijau_rimba"
                app:layout_constraintBottom_toBottomOf="@+id/textStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textStatus" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>